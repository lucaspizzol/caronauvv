// CaronaUVV - gerado por backend/scripts/gerar_docs_banco.py
// Cole em https://dbdiagram.io

Table usuarios {
  id integer [pk]
  matricula varchar(20) [unique, not null]
  email varchar(255) [unique, not null]
  nome varchar(150) [not null]
  curso varchar(120)
  telefone varchar(20) [not null]
  bairro varchar(100) [not null]
  endereco varchar(255)
  casa_lat float
  casa_lng float
  foto_url varchar(500)
  chave_pix varchar(150)
  senha_hash varchar(255) [not null]
  is_admin boolean [not null, default: false]
  verificado boolean [not null, default: false]
  is_active boolean [not null, default: true]
  ultimo_login_em timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table veiculos {
  id integer [pk]
  usuario_id integer [not null]
  modelo varchar(80) [not null]
  cor varchar(30) [not null]
  placa varchar(10) [unique, not null]
  created_at timestamp [not null, default: `now()`]
}

Table contatos_confianca {
  id integer [pk]
  usuario_id integer [not null]
  nome varchar(100) [not null]
  telefone varchar(20) [not null]
  created_at timestamp [not null, default: `now()`]
}

Table caronas {
  id integer [pk]
  motorista_id integer [not null]
  veiculo_id integer
  sentido varchar(10) [not null, default: 'ida']
  bairro_origem varchar(100) [not null]
  endereco_origem varchar(255) [not null]
  destino varchar(255) [not null, default: 'UVV - Entrada principal']
  origem_lat float
  origem_lng float
  destino_lat float
  destino_lng float
  distancia_km float
  duracao_min integer
  rota_polyline text
  data_hora_saida timestamp [not null]
  vagas integer [not null]
  valor_por_passageiro numeric(6,2) [not null, default: 0]
  reserva_automatica boolean [not null, default: false]
  status varchar(20) [not null, default: 'ativa']
  iniciada_em timestamp
  concluida_em timestamp
  cancelada_em timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  Note: 'CHECK sentido IN (\'ida\', \'volta\')\nCHECK status IN (\'ativa\', \'lotada\', \'em_andamento\', \'concluida\', \'cancelada\')\nCHECK vagas BETWEEN 1 AND 6\nCHECK valor_por_passageiro >= 0'
}

Table solicitacoes {
  id integer [pk]
  carona_id integer [not null]
  passageiro_id integer [not null]
  endereco_embarque varchar(255)
  embarque_lat float
  embarque_lng float
  desvio_min integer
  distancia_rota_m integer
  mensagem varchar(300)
  status varchar(20) [not null, default: 'pendente']
  respondida_em timestamp
  expira_em timestamp
  pin_embarque varchar(4)
  embarcou_em timestamp
  metodo_embarque varchar(20)
  faltou boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  indexes {
    (carona_id, passageiro_id) [unique, name: 'uq_solicitacao_carona_passageiro']
  }
  Note: 'CHECK metodo_embarque IN (\'pin+gps\', \'gps\', \'manual\')\nCHECK status IN (\'pendente\', \'aceita\', \'recusada\', \'cancelada\', \'expirada\')'
}

Table posicoes_gps {
  id integer [pk]
  carona_id integer [not null]
  lat float [not null]
  lng float [not null]
  registrada_em timestamp [not null, default: `now()`]
}

Table avaliacoes {
  id integer [pk]
  solicitacao_id integer [not null]
  avaliador_id integer [not null]
  avaliado_id integer [not null]
  nota integer [not null]
  comentario varchar(500)
  created_at timestamp [not null, default: `now()`]
  indexes {
    (solicitacao_id, avaliador_id) [unique, name: 'uq_avaliacao_solicitacao_avaliador']
  }
  Note: 'CHECK avaliador_id <> avaliado_id\nCHECK nota BETWEEN 1 AND 5'
}

Table avaliacao_tags {
  id integer [pk]
  avaliacao_id integer [not null]
  tag varchar(40) [not null]
  indexes {
    (avaliacao_id, tag) [unique, name: 'uq_avaliacao_tag']
  }
}

Table pagamentos {
  id integer [pk]
  solicitacao_id integer [unique, not null]
  valor numeric(6,2) [not null]
  metodo varchar(20) [not null, default: 'pix']
  pix_copia_cola text
  status varchar(20) [not null, default: 'pendente']
  pago_em timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  Note: 'CHECK metodo IN (\'pix\', \'dinheiro\')\nCHECK status IN (\'pendente\', \'pago\', \'cancelado\')\nCHECK valor >= 0'
}

Table notificacoes {
  id integer [pk]
  usuario_id integer [not null]
  carona_id integer
  tipo varchar(40) [not null]
  titulo varchar(120) [not null]
  texto varchar(500) [not null]
  lida boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
  indexes {
    (usuario_id, lida) [name: 'ix_notificacoes_usuario_lida']
  }
}

Table alertas {
  id integer [pk]
  carona_id integer [not null]
  usuario_id integer
  tipo varchar(30) [not null]
  detalhe varchar(300)
  lat float
  lng float
  resposta varchar(20)
  respondido_em timestamp
  status varchar(20) [not null, default: 'aguardando']
  contatos_avisados_em timestamp
  created_at timestamp [not null, default: `now()`]
  resolvido_em timestamp
  Note: 'CHECK resposta IN (\'tudo_bem\', \'preciso_ajuda\', \'sem_resposta\')\nCHECK status IN (\'aguardando\', \'em_revisao\', \'resolvido\')\nCHECK tipo IN (\'parada_longa\', \'sinal_perdido\', \'desvio_rota\', \'pin_sem_gps\')'
}

Table links_compartilhados {
  id integer [pk]
  carona_id integer [not null]
  usuario_id integer [not null]
  contato_id integer
  token varchar(64) [unique, not null]
  expira_em timestamp [not null]
  revogado_em timestamp
  acessos integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
}

Table denuncias {
  id integer [pk]
  denunciante_id integer [not null]
  denunciado_id integer [not null]
  carona_id integer
  motivo varchar(60) [not null]
  descricao text
  status varchar(20) [not null, default: 'aberta']
  analisada_por_id integer
  resolucao text
  encerrada_em timestamp
  created_at timestamp [not null, default: `now()`]
  Note: 'CHECK denunciante_id <> denunciado_id\nCHECK status IN (\'aberta\', \'em_analise\', \'encerrada\')'
}

Table buscas {
  id integer [pk]
  usuario_id integer
  bairro varchar(100) [not null]
  sentido varchar(10) [not null, default: 'ida']
  data_desejada date [not null]
  hora_inicio time
  hora_fim time
  qtd_resultados integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  Note: 'CHECK sentido IN (\'ida\', \'volta\')'
}

Table configuracoes {
  chave varchar(60) [pk]
  valor varchar(255) [not null]
  descricao varchar(255)
  updated_at timestamp [not null, default: `now()`]
}

Ref: veiculos.usuario_id > usuarios.id [delete: cascade]
Ref: contatos_confianca.usuario_id > usuarios.id [delete: cascade]
Ref: caronas.motorista_id > usuarios.id
Ref: caronas.veiculo_id > veiculos.id [delete: set null]
Ref: solicitacoes.carona_id > caronas.id [delete: cascade]
Ref: solicitacoes.passageiro_id > usuarios.id
Ref: posicoes_gps.carona_id > caronas.id [delete: cascade]
Ref: avaliacoes.solicitacao_id > solicitacoes.id [delete: cascade]
Ref: avaliacoes.avaliador_id > usuarios.id
Ref: avaliacoes.avaliado_id > usuarios.id
Ref: avaliacao_tags.avaliacao_id > avaliacoes.id [delete: cascade]
Ref: pagamentos.solicitacao_id - solicitacoes.id [delete: cascade]
Ref: notificacoes.usuario_id > usuarios.id [delete: cascade]
Ref: notificacoes.carona_id > caronas.id [delete: set null]
Ref: alertas.carona_id > caronas.id [delete: cascade]
Ref: alertas.usuario_id > usuarios.id [delete: set null]
Ref: links_compartilhados.carona_id > caronas.id [delete: cascade]
Ref: links_compartilhados.usuario_id > usuarios.id [delete: cascade]
Ref: links_compartilhados.contato_id > contatos_confianca.id [delete: set null]
Ref: denuncias.denunciante_id > usuarios.id
Ref: denuncias.denunciado_id > usuarios.id
Ref: denuncias.carona_id > caronas.id [delete: set null]
Ref: denuncias.analisada_por_id > usuarios.id [delete: set null]
Ref: buscas.usuario_id > usuarios.id [delete: set null]

TableGroup auth {
  usuarios
  veiculos
  contatos_confianca
}

TableGroup caronas {
  caronas
  solicitacoes
  posicoes_gps
}

TableGroup avaliacoes {
  avaliacoes
  avaliacao_tags
  pagamentos
}

TableGroup notificacoes {
  notificacoes
}

TableGroup seguranca {
  alertas
  links_compartilhados
  denuncias
}

TableGroup admin {
  buscas
  configuracoes
}
