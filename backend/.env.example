# Copie este arquivo para .env e ajuste os valores (o .env nao vai para o Git).

# Chave usada para assinar os tokens de login. Em producao, use um valor longo e aleatorio:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Banco: sem DATABASE_URL usa SQLite em instance/caronauvv.db.
# Producao (PostgreSQL): postgresql://usuario:senha@host:5432/caronauvv
# DATABASE_URL=

# Validade do login em segundos (padrao: 7 dias)
TOKEN_MAX_AGE=604800

# Origens do frontend liberadas no CORS (separe por virgula). * = todas
CORS_ORIGINS=http://localhost:5173

# Nivel do log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 1 = modo debug do Flask (desenvolvimento); 0 em producao
FLASK_DEBUG=1

# Log tambem em arquivo, com rotacao (ex.: logs/caronauvv.log). Vazio = so no terminal.
LOG_FILE=

# Cadastro: so e-mails destes dominios (aceita subdominios, ex.: aluno.uvv.br)
DOMINIOS_EMAIL=uvv.br

# E-mail (SMTP) para enviar o codigo de verificacao. Sem MAIL_SERVER, o codigo
# aparece no log e na tela ("modo de demonstracao"). Ex. Gmail: smtp.gmail.com / 587 / senha de app.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Mostra o codigo na resposta da API quando nao ha servidor de e-mail. Em producao: 0
MOSTRAR_CODIGO_DEV=1

# Protecao do login: bloqueia apos N senhas erradas em X minutos
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MIN=10
